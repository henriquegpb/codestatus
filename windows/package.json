{
  "name": "codestatus-windows",
  "version": "0.5.1",
  "description": "Session monitor for Claude Code, in the Windows system tray",
  "main": "src/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "npm run test:unit && npm run test:transport",
    "test:unit": "node test/reducer.test.js && node test/installer.test.js && node test/platform.test.js && node test/titles.test.js",
    "test:reducer": "node test/reducer.test.js",
    "test:installer": "node test/installer.test.js",
    "test:platform": "node test/platform.test.js",
    "test:titles": "node test/titles.test.js",
    "test:transport": "node test/transport.test.js",
    "preview": "electron test/preview.js",
    "icons": "electron test/render-icons.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.codestatus.windows",
    "productName": "CodeStatus",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "hook",
        "to": "hook"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "CodeStatus-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodeStatus",
      "deleteAppDataOnUninstall": false,
      "include": "build/uninstall.nsh"
    }
  }
}
